OPENROUTER_API_KEY=<your_openrouter_api_key>
E2B_API_KEY=<your_e2b_api_key_here>
# Leave empty to run on the stock E2B image. Set to the template name only
# after building it with `pnpm sandbox:build` (for example finance-analysis:v1);
# naming a template that has not been built makes every sandbox start fail.
E2B_SANDBOX_TEMPLATE=
DATABASE_HOST=<your_supabase_transaction_pooler_host>
DATABASE_PORT=6543
DATABASE_USER=<your_supabase_transaction_pooler_user>
DATABASE_PASSWORD=<your_supabase_database_password>
SESSION_SIGNING_SECRET=<long_random_server_only_secret>

# Set to true only when running the evaluation harness or inspecting its
# agents in Mastra Studio. Leave unset in production: the baseline evaluation
# agent has the Python tool and no guardrail processors.
EVALUATION_AGENTS_ENABLED=
